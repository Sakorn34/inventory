# ฐานข้อมูล / backup — มีข้อมูลลูกค้า ห้ามขึ้น repo สาธารณะ
*.sql
*.sql.zip
*.mdb
*.accdb
*.bak
*.log

# ไฟล์ Excel/CSV ส่วนใหญ่เป็นข้อมูลจริงของลูกค้า/สินค้า
